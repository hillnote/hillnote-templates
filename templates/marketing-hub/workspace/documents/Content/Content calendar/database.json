{
  "name": "Content calendar",
  "folderKind": "calendar-database",
  "columns": [
    {
      "id": "title",
      "name": "Content",
      "type": "title",
      "width": 280
    },
    {
      "id": "status",
      "name": "Status",
      "type": "status",
      "options": [
        "Idea",
        "Drafting",
        "In review",
        "Scheduled",
        "Published"
      ],
      "optionColors": {
        "Idea": "gray",
        "Drafting": "blue",
        "In review": "amber",
        "Scheduled": "teal",
        "Published": "emerald"
      },
      "optionStates": {
        "Idea": "normal",
        "Drafting": "normal",
        "In review": "normal",
        "Scheduled": "normal",
        "Published": "done"
      },
      "defaultValue": "Idea"
    },
    {
      "id": "channel",
      "name": "Channel",
      "type": "select",
      "options": [
        "Blog",
        "LinkedIn",
        "X",
        "Email",
        "YouTube"
      ],
      "optionColors": {
        "Blog": "emerald",
        "LinkedIn": "blue",
        "X": "darkGray",
        "Email": "cyan",
        "YouTube": "red"
      }
    },
    {
      "id": "format",
      "name": "Format",
      "type": "select",
      "options": [
        "Article",
        "Post",
        "Thread",
        "Email",
        "Video",
        "Case study"
      ],
      "optionColors": {
        "Article": "teal",
        "Post": "blue",
        "Thread": "gray",
        "Email": "cyan",
        "Video": "red",
        "Case study": "purple"
      }
    },
    {
      "id": "campaign",
      "name": "Campaign",
      "type": "select",
      "options": [
        "Q4 launch",
        "SEO cluster",
        "Customer stories",
        "Newsletter"
      ],
      "optionColors": {
        "Q4 launch": "orange",
        "SEO cluster": "lime",
        "Customer stories": "pink",
        "Newsletter": "cyan"
      }
    },
    {
      "id": "owner",
      "name": "Owner",
      "type": "select",
      "options": [
        "Dana",
        "Leo",
        "Priya",
        "Marcus"
      ],
      "optionColors": {
        "Dana": "purple",
        "Leo": "teal",
        "Priya": "pink",
        "Marcus": "blue"
      }
    },
    {
      "id": "publish_date",
      "name": "Publish date",
      "type": "date"
    }
  ],
  "views": [
    {
      "id": "default",
      "name": "Calendar",
      "type": "calendar",
      "dateColumn": "publish_date",
      "colorByColumn": "channel",
      "calendarViewMode": "dayGridMonth",
      "filters": [],
      "sorts": []
    },
    {
      "id": "board",
      "name": "Board",
      "type": "kanban",
      "groupBy": "status",
      "filters": [],
      "sorts": [
        {
          "column": "publish_date",
          "direction": "asc"
        }
      ]
    },
    {
      "id": "owners",
      "name": "By owner",
      "type": "kanban",
      "groupBy": "owner",
      "filters": [],
      "sorts": [
        {
          "column": "publish_date",
          "direction": "asc"
        }
      ]
    },
    {
      "id": "table",
      "name": "Table",
      "type": "table",
      "filters": [],
      "sorts": [
        {
          "column": "publish_date",
          "direction": "asc"
        }
      ]
    }
  ],
  "defaultView": "default"
}
