{
  "name": "Lift log",
  "folderKind": "fitness",
  "columns": [
    {
      "id": "title",
      "name": "Entry",
      "type": "title",
      "width": 200
    },
    {
      "id": "exercise",
      "name": "Exercise",
      "type": "select",
      "options": [
        "Back squat",
        "Bench press",
        "Deadlift",
        "Overhead press"
      ],
      "optionColors": {
        "Back squat": "purple",
        "Bench press": "blue",
        "Deadlift": "orange",
        "Overhead press": "teal"
      },
      "width": 150
    },
    {
      "id": "date",
      "name": "Date",
      "type": "date"
    },
    {
      "id": "week",
      "name": "Block week",
      "type": "number",
      "width": 100
    },
    {
      "id": "sets",
      "name": "Sets",
      "type": "number",
      "width": 70
    },
    {
      "id": "reps",
      "name": "Reps",
      "type": "number",
      "width": 70
    },
    {
      "id": "weight",
      "name": "Weight",
      "type": "number",
      "width": 90
    },
    {
      "id": "rpe",
      "name": "RPE",
      "type": "number",
      "width": 70
    },
    {
      "id": "est_1rm",
      "name": "Est. 1RM",
      "type": "formula",
      "formulaMode": "formula",
      "formula": "ROUND({Weight} * (1 + {Reps} / 30), 1)",
      "resultType": "number",
      "width": 100
    },
    {
      "id": "volume",
      "name": "Volume",
      "type": "formula",
      "formulaMode": "formula",
      "formula": "{Sets} * {Reps} * {Weight}",
      "resultType": "number",
      "width": 100
    }
  ],
  "views": [
    {
      "id": "default",
      "name": "Log",
      "type": "table",
      "filters": [],
      "sorts": [
        {
          "column": "date",
          "direction": "desc"
        }
      ]
    },
    {
      "id": "trend",
      "name": "Est. 1RM trend",
      "type": "chart",
      "chartType": "line",
      "labelColumn": "date",
      "dateBucket": "week",
      "valueColumn": "est_1rm",
      "aggregation": "max",
      "splitColumn": "exercise",
      "filters": [],
      "sorts": []
    },
    {
      "id": "volume_chart",
      "name": "Weekly volume",
      "type": "chart",
      "chartType": "bar",
      "labelColumn": "date",
      "dateBucket": "week",
      "valueColumn": "volume",
      "aggregation": "sum",
      "splitColumn": "exercise",
      "filters": [],
      "sorts": []
    },
    {
      "id": "by_lift",
      "name": "By lift",
      "type": "kanban",
      "groupBy": "exercise",
      "filters": [],
      "sorts": [
        {
          "column": "date",
          "direction": "desc"
        }
      ]
    }
  ],
  "defaultView": "default"
}
